# ==================== 环境变量配置示例 ====================
# 文件名: .env.example
# 说明: 复制此文件为 .env 并填写实际的配置信息
# 位置: /data/share/luying/shinyApp/.env (或根据需要调整)
# ======================================================

# ==================== 数据库配置 ====================
# PostgreSQL数据库名称
DB_NAME=research_db

# 数据库主机地址
# 本地: localhost 或 127.0.0.1
# 远程: 实际的服务器IP或域名
DB_HOST=localhost

# 数据库端口（PostgreSQL默认5432）
DB_PORT=5432

# 数据库用户名
DB_USER=research_user

# 数据库密码（请使用强密码）
DB_PASSWORD=your_secure_password_here

# ==================== 应用配置 ====================
# 应用运行端口
APP_PORT=3838

# 应用主机地址
# 本地测试: 127.0.0.1
# 生产环境: 0.0.0.0（允许外部访问）
APP_HOST=127.0.0.1

# 调试模式（TRUE或FALSE）
# TRUE: 跳过登录验证，使用模拟数据
# FALSE: 启用完整认证和数据库功能
DEBUG_MODE=FALSE

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# 日志文件路径（可选，默认输出到控制台）
# LOG_FILE=/var/log/research-manage/app.log

# ==================== 会话配置 ====================
# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# ==================== 文件上传配置 ====================
# 最大上传文件大小（MB）
MAX_UPLOAD_SIZE=50

# 文件存储路径
# UPLOAD_DIR=/data/research-manage/uploads

# ==================== 邮件配置（可选） ====================
# SMTP服务器
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=smtp_password
# SMTP_FROM=noreply@example.com

# ==================== 备份配置（可选） ====================
# 备份目录
# BACKUP_DIR=/backup/research-manage

# 备份保留天数
# BACKUP_RETENTION_DAYS=30

# ==================== 安全配置 ====================
# 应用密钥（用于会话加密，随机字符串）
# APP_SECRET=your_random_secret_key_here

# 启用HTTPS（TRUE或FALSE）
# ENABLE_HTTPS=TRUE

# SSL证书路径（如果启用HTTPS）
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem

# ==================== 其他配置 ====================
# 应用名称（可选，覆盖默认值）
# APP_NAME=科研项目管理系统

# 时区设置
# TZ=Asia/Shanghai

# ==================== 开发配置 ====================
# 热重载（仅开发环境）
# HOT_RELOAD=TRUE

# 显示调试信息
# SHOW_DEBUG_INFO=TRUE

# ======================================================
# 配置说明：
# 1. 不要在生产环境中使用示例密码
# 2. 确保.env文件的权限设置正确（建议600）
# 3. 不要将.env文件提交到版本控制系统
# 4. 定期更换密码和密钥
# 5. 备份配置文件到安全位置
# ======================================================
